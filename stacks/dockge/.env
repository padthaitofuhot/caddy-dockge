#
# ⚠️ REQUIRED SETTINGS ⚠️
#
# You MUST set this to your dockge host's FQDN to use SSL.
HOST_FQDN=my.example.tld
# You MUST set this to get SSL certs from Let's Encrypt
HOST_EMAIL=mail@example.tld
# Set this only if you are using a service which requires token authentication
API_TOKEN=<token>
# Registers your acceptance of the Let's Encrypt EULA and Terms of Service
# This must be set true to enable automatic SSL!
ACME_AGREE=true

#
# Advanced settings
#
# Tell Dockge where your stacks directory is
DOCKGE_STACKS_DIR=/opt/stacks